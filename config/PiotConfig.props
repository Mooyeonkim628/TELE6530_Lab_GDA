#####
# Configuration file for the Gateway Device App (GDA)
#
# This provides a section-based configuration format for use by
# ConfigUtil with keys defined in ConfigConst.
#
# IMPORTANT: Edit this file to meet your local system requirements.
#

#
# Cloud client configuration information
#
[Cloud.GatewayService]
cloudServiceName = Ubidots

[Cloud.GatewayService.AWS]
credFile         = ./cred/AwsCloudCred.props
certFile         = ./certs/AwsCloudCert.pem
privateKeyFile   = ./certs/AwsCloudKey.key
cloudServiceName = AWS
host             = {TODO: hostname}
port             = 1883
securePort       = 8883
defaultQoS       = 0
keepAlive        = 30
useAsyncClient   = True
enableAuth       = True
enableCrypt      = True
baseUrl          =
baseTopic        =

[Cloud.GatewayService.Ubidots]
credFile         = ./cred/UbidotsCloudCred.props
certFile         = ./certs/UbidotsCloudCert.pem
cloudServiceName = Ubidots
host             = industrial.api.ubidots.com
port             = 1883
securePort       = 8883
defaultQoS       = 0
keepAlive        = 30
useAsyncClient   = True
enableAuth       = True
enableCrypt      = True
baseUrl          =
baseTopic        = /v1.6/devices/

#
# SMTP client configuration information
#
[Smtp.GatewayService]
credFile       = ./cred/PiotSmtpCred.props
host           = localhost
port           = 25
securePort     = 587
enableAuth     = True
enableCrypt    = True

#
# MQTT client configuration information
#
[Mqtt.GatewayService]
credFile       = ./cred/PiotMqttCred.props
certFile       = ./certs/server.crt
host           = localhost
port           = 1883
securePort     = 8883
defaultQoS     = 0
keepAlive      = 30
enableAuth     = False
enableCrypt    = True
useAsyncClient = False

#
# CoAP client and server configuration information
#
[Coap.GatewayService]
credFile       = ./cred/PiotCoapCred.props
certFile       = ./cert/PiotCoapLocalCertFile.pem
host           = localhost
port           = 5683
securePort     = 5684
enableAuth     = False
enableCrypt    = False
enableConfirmedMsgs = True

#
# Persistence client configuration information
#
[Data.GatewayService]
credFile = ./cred/PiotPersistenceCred.props
host = localhost
port = 6380
enableCrypt = False


#
# GDA specific configuration information
#
[GatewayDevice]
deviceLocationID        = gatewaydevice001
enableLogging           = True
pollCycleSecs           = 5
enableMqttClient        = True
enableCoapServer        = False
enableCoapClient        = False
enableCloudClient       = True
enableSmtpClient        = False
enablePersistenceClient = True
enableSystemPerformance = True
testGdaDataPath         = /tmp/gda-data
testCdaDataPath         = /tmp/cda-data
testEmptyApp            = False
enableRunForever        = True

handleHumidityChangeOnDevice=true
humidityMaxTimePastThreshold=5
nominalHumiditySetting=40.0
triggerHumidifierFloor=40.0
triggerHumidifierCeiling=60.0
cloudOverrideDurationSecs = 60